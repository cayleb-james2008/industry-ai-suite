# Python-generated bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local credentials and environment overrides (keep example templates visible)
.env
.env.*
!.env.example
!.env.*.example

# Local run output and temporary files; fixture/source receipt data stays visible.
/run-output/
/runtime/
/runtime-receipts/
/local-receipts/
/.tmp/
/tmp/
/temp/
*.tmp
*.swp
*~

# Large locally downloaded model stores and weight files.
/models/
/weights/
/checkpoints/
/model-cache/
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.bin

# Never hide source, tests, or fixtures merely because of a weight-file suffix.
!tests/**/*.gguf
!tests/**/*.safetensors
!tests/**/*.ckpt
!tests/**/*.pt
!tests/**/*.pth
!tests/**/*.bin
!apps/**/tests/**/*.gguf
!apps/**/tests/**/*.safetensors
!apps/**/tests/**/*.ckpt
!apps/**/tests/**/*.pt
!apps/**/tests/**/*.pth
!apps/**/tests/**/*.bin
!apps/**/fixtures/**/*.gguf
!apps/**/fixtures/**/*.safetensors
!apps/**/fixtures/**/*.ckpt
!apps/**/fixtures/**/*.pt
!apps/**/fixtures/**/*.pth
!apps/**/fixtures/**/*.bin
